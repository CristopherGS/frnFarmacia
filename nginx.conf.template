map $http_x_forwarded_proto $external_scheme {
 default $scheme;
 https https;
 http http;
}
server {
 listen 0.0.0.0:80;
 server_tokens off;
 root /usr/share/nginx/html;
 resolver 127.0.0.11 valid=30s ipv6=off;
 set $backend_url "${API_UPSTREAM}";
 add_header X-Content-Type-Options nosniff always;
 add_header X-Frame-Options DENY always;
 add_header Referrer-Policy same-origin always;
 location ^~ /api/ {
  proxy_pass $backend_url$request_uri;
  proxy_ssl_server_name on;
  proxy_ssl_verify on;
  proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
  proxy_set_header Host $proxy_host;
  proxy_set_header X-Forwarded-Proto $external_scheme;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header Forwarded "";
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
 }
 location = /healthz { access_log off; default_type text/plain; return 200 'ok'; }
 location = /index.html { expires -1; }
 location ~* \.(?:js|css|map|ico|png|jpg|jpeg|svg|webp|woff|woff2)$ { try_files $uri =404; }
 location / { try_files $uri $uri/ /index.html; }
}
